{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://texttechnologylab.org/dua/schema/distributed/shard-manifest-v1.schema.json",
  "title": "DUA Distributed Shard Manifest v1",
  "type": "object",
  "required": ["schema", "shardId", "partitionId", "epoch", "objects", "replicas"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "dua.distributed.shard.v1" },
    "shardId": { "type": "string" },
    "partitionId": { "type": "string" },
    "epoch": { "type": "integer", "minimum": 0 },
    "rangeStart": { "type": ["string", "integer", "null"] },
    "rangeEndExclusive": { "type": ["string", "integer", "null"] },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectRef" }
    },
    "replicas": {
      "type": "array",
      "items": { "$ref": "#/$defs/replica" }
    },
    "wal": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectRef" }
    },
    "snapshot": { "$ref": "#/$defs/objectRef" },
    "merkleRoot": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "$defs": {
    "replica": {
      "type": "object",
      "required": ["nodeId", "uri", "role", "state"],
      "additionalProperties": false,
      "properties": {
        "nodeId": { "type": "string" },
        "uri": { "type": "string" },
        "role": { "enum": ["leader", "follower", "learner", "cache"] },
        "state": { "enum": ["online", "syncing", "stale", "offline"] },
        "lastAppliedSequence": { "type": "integer", "minimum": 0 }
      }
    },
    "objectRef": {
      "type": "object",
      "required": ["uri", "sha256"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "byteLength": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
