{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://texttechnologylab.org/dua/schema/service/module-descriptor-v1.schema.json",
  "title": "DUA service module descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "module",
    "services"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dua.service.module.v1"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "responsibility"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/moduleKind"
        },
        "responsibility": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "serviceName",
        "moduleKind",
        "performanceClass",
        "protocols",
        "ownedData",
        "derivedData",
        "interactions",
        "canonicalAuthority",
        "optionalAccelerator",
        "usefulFor",
        "relativePerformance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "serviceName": {
          "type": "string",
          "minLength": 1
        },
        "moduleKind": {
          "$ref": "#/$defs/moduleKind"
        },
        "performanceClass": {
          "enum": [
            "HOT_PATH",
            "LOW_LATENCY",
            "HIGH_THROUGHPUT",
            "BATCH_ANALYTIC",
            "COLD_PATH"
          ]
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "IN_PROCESS",
              "GRPC",
              "HTTP_OPENAPI",
              "EVENT_STREAM",
              "ARROW_FLIGHT",
              "OBJECT_STORE",
              "JDBC",
              "NATIVE_DRIVER"
            ]
          }
        },
        "ownedData": {
          "$ref": "#/$defs/dataClassArray"
        },
        "derivedData": {
          "$ref": "#/$defs/dataClassArray"
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interaction"
          }
        },
        "canonicalAuthority": {
          "type": "boolean",
          "description": "True only for services allowed to own canonical corpus/CAS/payload state."
        },
        "optionalAccelerator": {
          "type": "boolean",
          "description": "True when correctness can fall back to DUA Core without this service."
        },
        "usefulFor": {
          "type": "string",
          "minLength": 1
        },
        "relativePerformance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetServiceId",
        "purpose",
        "protocol",
        "requiredForCorrectness"
      ],
      "properties": {
        "targetServiceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "enum": [
            "IN_PROCESS",
            "GRPC",
            "HTTP_OPENAPI",
            "EVENT_STREAM",
            "ARROW_FLIGHT",
            "OBJECT_STORE",
            "JDBC",
            "NATIVE_DRIVER"
          ]
        },
        "requiredForCorrectness": {
          "type": "boolean"
        }
      }
    },
    "dataClassArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CANONICAL_CAS",
          "CANONICAL_CORPUS_REGISTRY",
          "CANONICAL_PAYLOAD",
          "TYPE_SYSTEM",
          "REVISION_LOG",
          "TRANSPORT_PACKAGE",
          "PIPELINE_RUN_STATE",
          "PROJECTION_EVENT",
          "DERIVED_INDEX",
          "DERIVED_ANALYTIC",
          "DERIVED_GRAPH",
          "DERIVED_VECTOR",
          "UI_VIEW_MODEL",
          "ACCESS_POLICY",
          "TELEMETRY"
        ]
      }
    },
    "moduleKind": {
      "enum": [
        "CORE",
        "TRANSPORT",
        "PIPELINE_RUNTIME",
        "EVENT_LOG",
        "QUERY_COORDINATION",
        "QUERY_ACCELERATOR",
        "INSPECTOR",
        "GOVERNANCE",
        "OBSERVABILITY"
      ]
    }
  }
}
