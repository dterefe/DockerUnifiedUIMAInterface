{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://texttechnologylab.org/dua/schema/distributed/routing-table-v1.schema.json",
  "title": "DUA Distributed Routing Table v1",
  "type": "object",
  "required": ["schema", "routingTableId", "epoch", "routes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "dua.distributed.routing.v1" },
    "routingTableId": { "type": "string" },
    "epoch": { "type": "integer", "minimum": 0 },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": ["partitionId", "shardId", "primaryUri", "replicaUris"],
      "additionalProperties": false,
      "properties": {
        "partitionId": { "type": "string" },
        "shardId": { "type": "string" },
        "rangeStart": { "type": ["string", "integer", "null"] },
        "rangeEndExclusive": { "type": ["string", "integer", "null"] },
        "primaryUri": { "type": "string" },
        "replicaUris": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cacheUris": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
