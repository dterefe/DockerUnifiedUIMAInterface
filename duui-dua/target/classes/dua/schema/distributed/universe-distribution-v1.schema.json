{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://texttechnologylab.org/dua/schema/distributed/universe-distribution-v1.schema.json",
  "title": "DUA Distributed Universe Manifest v1",
  "type": "object",
  "required": ["schema", "universeId", "epoch", "partitions", "routingTables"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "dua.distributed.universe.v1" },
    "universeId": { "type": "string", "minLength": 1 },
    "epoch": { "type": "integer", "minimum": 0 },
    "createdEpochMs": { "type": "integer", "minimum": 0 },
    "partitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/partitionRef" }
    },
    "routingTables": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectRef" }
    },
    "replicationPolicy": {
      "type": "object",
      "required": ["minReplicas", "writeQuorum", "readQuorum"],
      "additionalProperties": false,
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 1 },
        "writeQuorum": { "type": "integer", "minimum": 1 },
        "readQuorum": { "type": "integer", "minimum": 1 },
        "placement": {
          "enum": ["single-node", "rack-aware", "region-aware", "manual"]
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": ["cas-slots", "cas-arrays", "payloads", "graph-navigation", "columnar-indexes", "wal", "snapshots"]
      }
    }
  },
  "$defs": {
    "partitionRef": {
      "type": "object",
      "required": ["partitionId", "kind", "manifest"],
      "additionalProperties": false,
      "properties": {
        "partitionId": { "type": "string" },
        "kind": {
          "enum": ["cas", "payload", "graph", "columnar", "typesystem", "wal", "index"]
        },
        "scope": { "type": "string" },
        "manifest": { "$ref": "#/$defs/objectRef" }
      }
    },
    "objectRef": {
      "type": "object",
      "required": ["uri", "sha256"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "byteLength": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
