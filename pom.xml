<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.texttechnologylab</groupId>
    <artifactId>duui</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>DUUI - Docker Unified UIMA Interface</name>
    <description>Modular, scalable framework for automated and distributed text corpus analysis.</description>
    <url>https://www.texttechnologylab.org</url>

    <licenses>
        <license>
            <name>AGPL-3.0-or-later</name>
            <url>https://www.gnu.org/licenses/agpl.txt</url>
        </license>
    </licenses>

    <organization>
        <name>Texttechnology Lab</name>
        <url>https://www.texttechnologylab.org</url>
    </organization>

    <developers>
        <developer><id>abrami</id><name>Giuseppe Abrami</name><email>abrami@em.uni-frankfurt.de</email><organization>Goethe University Frankfurt</organization><roles><role>lead developer</role></roles></developer>
    </developers>

    <modules>
        <module>duui-base</module>
        <module>duui-storage</module>
        <module>duui-core</module>
        <module>duui-dua</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <duui.version>2.0.0-SNAPSHOT</duui.version>
        <uima.version>3.6.0</uima.version>
        <dkpro.core.version>2.4.0</dkpro.core.version>
        <typesystem.version>3.0.14</typesystem.version>
        <utilities.version>653a6a0850</utilities.version>
        <docker-java.version>3.6.0</docker-java.version>
        <podman.version>a3b54ecc45</podman.version>
        <fabric8-kubernetes.version>6.8.0</fabric8-kubernetes.version>
        <jackson.version>2.17.2</jackson.version>
        <junit.version>5.10.2</junit.version>
        <caffeine.version>3.1.8</caffeine.version>
        <luaj.version>3.0.1</luaj.version>
        <msgpack.version>0.9.1</msgpack.version>
        <sqlite.version>3.45.3.0</sqlite.version>
        <netty.version>4.1.118.Final</netty.version>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>ukp-oss-model-releases</id>
            <url>https://zoidberg.ukp.informatik.tu-darmstadt.de/artifactory/public-model-releases-local</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.texttechnologylab</groupId>
                <artifactId>duui-base</artifactId>
                <version>${duui.version}</version>
            </dependency>
            <dependency>
                <groupId>org.texttechnologylab</groupId>
                <artifactId>duui-storage</artifactId>
                <version>${duui.version}</version>
            </dependency>
            <dependency>
                <groupId>org.texttechnologylab</groupId>
                <artifactId>duui-core</artifactId>
                <version>${duui.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.uima</groupId>
                <artifactId>uimaj-core</artifactId>
                <version>${uima.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.uima</groupId>
                <artifactId>uimafit-core</artifactId>
                <version>${uima.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dkpro.core</groupId>
                <artifactId>dkpro-core-asl</artifactId>
                <version>${dkpro.core.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
